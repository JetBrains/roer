#!/bin/sh
# roer — the session contract.
#
# tmux is the engine underneath and is treated strictly as an implementation
# detail: every invocation pins the private "roer" socket and Roer's own
# config, so the user's tmux server, sessions and keybindings are never
# touched. Swapping the engine later means rewriting this file, nothing else.
set -eu

SOCKET=roer
ROER_HOME="${ROER_HOME:-$HOME/.roer}"
HANDOFFS="$ROER_HOME/handoffs"

# Resolve this script's real directory through any symlinks, so installing is
# just `ln -s .../scripts/roer ~/.local/bin/roer` while the config in the repo
# remains the single source of truth.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *)  self=$(dirname "$self")/$link ;;
    esac
done
SCRIPT_DIR=$(cd "$(dirname "$self")" && pwd)
CONF="$SCRIPT_DIR/roer-tmux.conf"

[ -f "$CONF" ] || { echo "roer: missing config at $CONF" >&2; exit 1; }

# Every tmux call is pinned to our socket and our config. `tm_exec` exists
# because `exec` only looks up external commands: `exec tm ...` would fail with
# "exec: tm: not found", and the exec matters — the shim must not linger as a
# parent process between the terminal and tmux.
tm() { tmux -L "$SOCKET" -f "$CONF" "$@"; }
tm_exec() { exec tmux -L "$SOCKET" -f "$CONF" "$@"; }

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

# Distinguishes two directories that share a basename. cksum is POSIX and
# stable across machines, and 16 bits is ample for the handful of same-named
# directories one person has open at once.
path_hash() {
    sum=$(printf '%s' "$1" | cksum | cut -d' ' -f1)
    printf '%04x' "$((sum & 0xffff))"
}

# A session belongs to a directory, not to a directory *name*: without the
# hash, /work/api and /tmp/api share one session and `roer` in the second
# silently hands you a shell sitting in the first. The basename stays in front
# so the name is still something you can recognise and type.
#
# tmux forbids "." and ":" in session names; fold everything unusual to "-".
session_name() {
    safe=$(printf '%s' "${PWD##*/}" | tr -c 'A-Za-z0-9_-' '-')
    printf '%s-%s' "${safe:-root}" "$(path_hash "$PWD")"
}

# The first name in the series that is free. "=" makes the target an exact
# name rather than a prefix match, so a session called "roer" does not make
# "roer-app" look taken. With no server running has-session simply fails,
# which is the answer we want.
free_name() {
    base=$1
    name=$base
    n=2
    while tm has-session -t "=$name" 2>/dev/null; do
        name="$base-$n"
        n=$((n + 1))
    done
    printf '%s' "$name"
}

new_id() {
    uuidgen | tr 'A-Z' 'a-z'
}

# A session's durable identity, unlike its name or pane: a name is freed the
# moment the session ends, so a later unrelated session can legitimately
# reuse it, and a pane id is recycled by the server. Stamped as a tmux user
# option so it survives for the session's whole life without a file of our
# own to keep in sync. Sessions from before this existed pick one up here,
# lazily, the first time anything looks them up — there is no migration step.
#
# set-option/show-options take a *pane* target even for a session option (the
# session is inferred from the pane), so "=$name" alone does not resolve —
# it needs the trailing colon to mean "the active pane of $name's active
# window".
ensure_id() {
    name=$1
    id=$(tm show-options -t "=$name:" -v -q "@roer_id" 2>/dev/null)
    if [ -z "$id" ]; then
        id=$(new_id)
        tm set-option -t "=$name:" "@roer_id" "$id" 2>/dev/null || true
    fi
    printf '%s' "$id"
}

usage() {
    cat <<'EOF'
roer — session host for agent terminals

usage:
  roer                  open this directory's session in the Roer app,
                        creating it if it is not running (same as `roer app`).
                        Inside a session, teleports that session instead.
  roer app [name]       the same, with the session named explicitly
  roer shell [name]     attach this directory's session to this terminal,
                        detaching any other client (terminal or app)
  roer new [name]       create a session that is always a new one, suffixing
                        the name until it is free
  roer attach [name]    take a session back, detaching whoever holds it;
                        with no name, lists sessions
  roer list             list sessions as TSV:
                        id<TAB>session<TAB>pane<TAB>attached|detached<TAB>cwd<TAB>command
  roer detach [name]    release the session; it keeps running with no client
  roer resume <id>      resume a Claude conversation inside a new session
  roer handoff          teleport this session into the Roer app (used by the skill)
  roer handoff --pane <id>
                        same, for the M-h key binding, which has no session
                        environment to read the pane from
  roer handoff --resume <id>
                        hand a conversation over when this terminal is not a
                        roer session and so cannot be attached

A session outlives every client, so it can move freely between terminal and
app. Exactly one client holds it at a time.
EOF
}

# The default: put the session in front of you in the app rather than in this
# terminal. `roer shell` is how you ask for it here instead. One session per
# directory either way — the app is just another client.
cmd_app() {
    name=${1:-$(session_name)}

    # Already inside a roer session: the session to open is this one, and
    # finding its pane and then letting go of it is cmd_handoff's job. Being
    # inside somebody else's tmux is not this case and falls through.
    if [ -n "${TMUX:-}" ]; then
        sock=$(tmux display-message -p '#{socket_path}' 2>/dev/null) || sock=
        case $sock in
            */"$SOCKET") cmd_handoff; return $? ;;
        esac
    fi

    # Created detached: this terminal must not become a client, because the
    # app is about to be one and a session only ever has the one.
    if ! tm has-session -t "=$name" 2>/dev/null; then
        tm new-session -d -s "$name" -c "$PWD" || return 1
    fi
    ensure_id "$name" >/dev/null
    # list-panes rather than display-message: as a *pane* target "=name" is
    # not a session, and tmux answers an unresolvable one with an empty line
    # and exit 0 rather than an error. The filter picks the active pane of the
    # active window, so the answer is one id however many there are.
    pane=$(tm list-panes -s -t "=$name" -F '#{pane_id}' \
        -f '#{&&:#{pane_active},#{window_active}}' 2>/dev/null | head -1)
    [ -n "$pane" ] || { echo "roer: no pane in session $name" >&2; return 1; }

    publish "[\"attach\", \"$(json_escape "$pane")\"]" "$name" "$PWD" || return $?
    # The terminal stays where it is, so without this the command looks like
    # it did nothing.
    echo "roer: $name is open in Roer"
}

cmd_shell() {
    name=${1:-$(session_name)}
    # No shell-command argument: tmux falls back to default-shell as a login
    # shell. -A attaches when the session exists, -D evicts the other client.
    tm_exec new-session -A -D -s "$name" -c "$PWD"
}

# Always a fresh session, which is what a launcher means by "new": `shell`
# reuses the session for a directory on purpose, so clicking New session twice
# there would hand back the first one, scrollback and all.
cmd_new() {
    name=$(free_name "${1:-$(session_name)}")
    # No -A: the name is free, and a surprise attach is the bug this avoids.
    tm_exec new-session -s "$name" -c "$PWD"
}

cmd_list() {
    # Stamp any session that predates @roer_id before formatting rows, so the
    # id column below is never empty for a session that actually exists.
    for sess in $(tm list-sessions -F '#{session_name}' 2>/dev/null); do
        ensure_id "$sess" >/dev/null
    done
    tm list-panes -a -F \
'#{@roer_id}	#{session_name}	#{pane_id}	#{?session_attached,attached,detached}	#{pane_current_path}	#{pane_current_command}' \
        2>/dev/null || true
}

cmd_attach() {
    if [ $# -eq 0 ]; then
        cmd_list
        return 0
    fi
    tm_exec attach -d -t "$1"
}

cmd_detach() {
    if [ -n "${TMUX:-}" ]; then
        tmux detach-client
    elif [ $# -gt 0 ]; then
        tm detach-client -s "$1"
    else
        echo "roer: outside a session, detach needs a session name" >&2
        return 2
    fi
}

# Resume a Claude conversation inside a roer session. Used as the fallback
# when the agent was started in a plain terminal that Roer can never attach
# to: the conversation continues, and because it lands in a roer session it
# becomes teleportable from then on.
cmd_resume() {
    [ $# -gt 0 ] || {
        echo "roer: resume needs an agent session id" >&2
        return 2
    }
    agent=$1
    # Interpolated into a shell-command string below, so keep it to the shape
    # of a session id.
    case $agent in
        ""|*[!0-9A-Fa-f-]*)
            echo "roer: not an agent session id: $agent" >&2
            return 2
            ;;
    esac
    # Always resume in manual mode. A transcript carries no permission mode of
    # its own, so a resumed conversation would pick up whatever the new session
    # defaults to — and an old turn that was mid-flight when it was abandoned
    # can start acting the moment it is restored. Resuming is not the place to
    # inherit auto: the person teleporting has not seen what that turn wants to
    # do. They can still switch modes once it is on screen.
    # A free name, not -A: with -A an existing "<dir>-resume" session is
    # attached instead of created, and tmux discards the shell command that
    # comes with it — so the conversation asked for here would never start and
    # the previous one would come up in its place.
    tm_exec new-session -s "$(free_name "$(session_name)-resume")" -c "$PWD" \
        "claude --resume $agent --permission-mode manual"
}

# How long Roer has to pick a record up, and then how long it may take to get
# the session on screen, both in 0.1s ticks. Attaching is allowed to be the
# slower half: by then the handoff is Roer's, and giving up on it is what is
# dangerous.
PENDING_TICKS=100   # 10s
CLAIM_TICKS=300     # 30s

# Write a record for the app and wait for it to be picked up. The record
# carries the shim arguments Roer should run, so session semantics stay here
# rather than being duplicated in the app.
#
# Three states, each reached by one atomic rename or unlink in one directory:
#
#   <file>           pending — written, nobody has it yet
#   <file>.claimed   Roer has it and is attaching
#   <file>.failed    Roer tried and could not; the session never moved
#   gone             Roer is showing the session; the terminal may let go
#
# The claim is what makes giving up safe. Deleting a pending record does not
# recall a handoff Roer has already been told about — it would attach anyway
# and evict a terminal that had just been told nothing moved. So the cancel is
# a rename: whoever renames first wins, and if Roer got there we stop treating
# the wait as ours to abandon.
publish() {
    args_json=$1
    label=$2
    # Defaults to $PWD for the CLI paths, where the caller is standing in the
    # session's own directory. A key binding is not: run-shell inherits the
    # server's working directory, so it passes the pane's path in.
    cwd=${3:-$PWD}
    file="$HANDOFFS/$(date +%Y%m%dT%H%M%S)-$$.json"

    mkdir -p "$HANDOFFS"
    # Write under a .partial name and rename, so the app's watcher can never
    # observe a half-written record.
    cat > "$file.partial" <<EOF
{
  "args": $args_json,
  "cwd": "$(json_escape "$cwd")",
  "label": "$(json_escape "$label")"
}
EOF
    mv "$file.partial" "$file"

    # Start Roer if it is not already up, and bring it forward if it is.
    # `open` is the only route macOS 14 and later honours for that: an app
    # cannot pull itself in front of a terminal, because the frontmost app has
    # to yield activation and a terminal never does. `open` needs a bundle,
    # though — set ROER_APP to one (`/path/to/Roer.app`) when running from a
    # checkout, where `tauri dev` builds a bare executable that LaunchServices
    # cannot address at all. Failure is not fatal: a running instance is
    # watching this directory either way, and it asks for attention itself.
    open -a "${ROER_APP:-Roer}" 2>/dev/null || true

    # Phase 1: wait for Roer to claim the record.
    waited=0
    while [ -f "$file" ] && [ "$waited" -lt "$PENDING_TICKS" ]; do
        sleep 0.1
        waited=$((waited + 1))
    done
    if [ -f "$file" ]; then
        # Cancel by rename, so it cannot half-happen: if this succeeds the
        # record is ours again and a Roer that wakes up later finds nothing to
        # claim. If it fails, Roer claimed it in the last tick — which is the
        # outcome we were waiting for, so carry on into phase 2.
        if mv "$file" "$file.cancelled" 2>/dev/null; then
            rm -f "$file.cancelled"
            # Nothing has been moved: a handoff still has its terminal, and a
            # session opened for the app is still sitting there detached.
            echo "roer: Roer did not take the session within 10s; nothing moved" >&2
            return 4
        fi
    fi

    # Phase 2: Roer has the record. It deletes it once the session is really
    # on screen, which is the only point at which the terminal may let go.
    waited=0
    while [ -f "$file.claimed" ] && [ "$waited" -lt "$CLAIM_TICKS" ]; do
        sleep 0.1
        waited=$((waited + 1))
    done
    if [ -f "$file.claimed" ]; then
        rm -f "$file.claimed"
        echo "roer: Roer took the session but never showed it; nothing moved" >&2
        return 4
    fi
    if [ -f "$file.failed" ]; then
        rm -f "$file.failed"
        echo "roer: Roer could not open the session; nothing moved" >&2
        return 4
    fi
    # Gone without a trace is success: Roer deleted the record itself.
}

cmd_handoff() {
    # Fallback path: the agent is running in a plain terminal whose pty Roer
    # can never attach to, so hand over the conversation instead of the
    # terminal. Nothing is detached here — the caller is told to close the
    # original, since two clients on one conversation is not a thing.
    if [ "${1:-}" = "--resume" ]; then
        agent=${2:-}
        case $agent in
            ""|*[!0-9A-Fa-f-]*)
                echo "roer: --resume needs an agent session id" >&2
                return 2
                ;;
        esac
        publish "[\"resume\", \"$(json_escape "$agent")\"]" "resume ${agent%%-*}"
        return $?
    fi

    # Pressed as a key binding (M-h). tmux has already expanded the pane, and
    # run-shell gives the command neither TMUX_PANE nor the pane's working
    # directory, so nothing here may be discovered from the environment.
    if [ "${1:-}" = "--pane" ]; then
        pane=${2:-}
        # Interpolated into the record's JSON, so hold it to the shape tmux
        # actually produces.
        case $pane in
            %[0-9]*) : ;;
            *)
                echo "roer: --pane needs a pane id like %3" >&2
                return 2
                ;;
        esac
        sess=$(tm display-message -p -t "$pane" '#{session_name}' 2>/dev/null) || sess=
        [ -n "$sess" ] || { echo "roer: no such pane: $pane" >&2; return 3; }
        ensure_id "$sess" >/dev/null
        cwd=$(tm display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)
        # The client holding the session now, captured before Roer takes it:
        # the fallback below has to name it. `detach-client -s` would detach
        # every client of the session, and by the time the handoff is
        # confirmed the only one left is Roer — so the session would land in
        # the app and be thrown straight back out, held by nobody.
        held_by=$(tm list-clients -t "=$sess" -F '#{client_tty}' 2>/dev/null | head -1)

        if publish "[\"attach\", \"$(json_escape "$pane")\"]" "$sess" "$cwd"; then
            # Roer's own `attach -d` has usually evicted that client already;
            # this is for one that somehow survived.
            if [ -n "$held_by" ]; then
                tm detach-client -t "$held_by" 2>/dev/null || true
            fi
            return 0
        fi
        # stderr from a backgrounded run-shell goes nowhere, and the session is
        # still sitting in the terminal, so the message has to land on screen.
        tm display-message -t "$pane" \
            "roer: Roer did not take the handoff; the session is still here" 2>/dev/null || true
        return 4
    fi

    [ -n "${TMUX:-}" ] || {
        echo "roer: not inside a session - start one with \`roer\` first" >&2
        return 2
    }
    # Inside tmux, $TMUX points at the right server, so a bare `tmux` is
    # correct here and also tells us whether this is *our* server.
    sock=$(tmux display-message -p '#{socket_path}')
    case $sock in
        */"$SOCKET") : ;;
        *)
            echo "roer: inside tmux on $sock, which is not the roer socket" >&2
            return 3
            ;;
    esac

    pane=${TMUX_PANE:-$(tmux display-message -p '#{pane_id}')}
    sess=$(tmux display-message -p '#{session_name}')
    ensure_id "$sess" >/dev/null

    publish "[\"attach\", \"$(json_escape "$pane")\"]" "$sess" || return $?

    # Best-effort: Roer attaches with `attach -d`, so its own attach has
    # usually evicted this client already and there is nothing left to
    # detach. This is the fallback for a client that somehow survived; the
    # session has moved either way, so a failure here is not a failure of
    # the handoff.
    tmux detach-client 2>/dev/null || true
}

# No arguments means the app, which is where a session is meant to end up.
cmd=${1:-app}
if [ $# -gt 0 ]; then shift; fi
case $cmd in
    app)            cmd_app "$@" ;;
    shell)          cmd_shell "$@" ;;
    new)            cmd_new "$@" ;;
    attach)         cmd_attach "$@" ;;
    list|ls)        cmd_list "$@" ;;
    detach)         cmd_detach "$@" ;;
    resume)         cmd_resume "$@" ;;
    handoff)        cmd_handoff "$@" ;;
    help|-h|--help) usage ;;
    *)
        echo "roer: unknown command: $cmd" >&2
        usage >&2
        exit 64
        ;;
esac
